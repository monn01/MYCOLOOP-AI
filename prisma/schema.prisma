// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
}

enum BatchStatus {
  RUNNING
  READY
  COMPLETED
  ABORTED
}

enum ReadinessStatus {
  BELUM_SIAP
  DALAM_PROSES
  SIAP_STERILISASI
}

enum AlertType {
  ANOMALY
  READY
  CONTAMINATION
}

/// Tiga stage pipeline fisik MYCOLOOP-AI (lihat PRD.md §1.1) — Smart Mixing,
/// Smart Pre-Conditioning, Smart Incubation Monitoring, masing-masing dengan
/// reading model sendiri (MixingReading/SensorReading/IncubationReading)
/// karena parameter sensornya berbeda, tapi berbagi Batch/AIDecision/Alert.
enum PipelineStage {
  MIXING
  PRE_CONDITIONING
  INCUBATION
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches Batch[]
}

model Batch {
  id        String        @id @default(cuid())
  startTime DateTime      @default(now())
  endTime   DateTime?
  status    BatchStatus   @default(RUNNING)
  stage     PipelineStage @default(PRE_CONDITIONING)
  formula   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  sensorReadings     SensorReading[]
  mixingReadings     MixingReading[]
  incubationReadings IncubationReading[]
  aiDecisions        AIDecision[]
  alerts             Alert[]

  @@index([status])
  @@index([stage])
}

/// Batch stage PRE_CONDITIONING (lihat PRD.md §7.2/§8) — suhu/kelembapan/pH chamber.
model SensorReading {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  suhu       Float
  kelembapan Float
  ph         Float

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, timestamp])
}

/// Batch stage MIXING (lihat PRD.md §7.5/§8) — kadar air & rasio C:N bahan baku sebelum pre-conditioning.
model MixingReading {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  kadarAir  Float
  rasioCN   Float
  beratKg   Float

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, timestamp])
}

/// Batch stage INCUBATION (lihat PRD.md §7.6/§8) — kondisi ruang inkubasi pasca sterilisasi+inokulasi.
model IncubationReading {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  suhu       Float
  kelembapan Float
  co2        Float
  cahaya     Float

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, timestamp])
}

model AIDecision {
  id         String          @id @default(cuid())
  timestamp  DateTime        @default(now())
  status     ReadinessStatus
  confidence Float
  reasoning  String

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, timestamp])
}

model Alert {
  id        String    @id @default(cuid())
  timestamp DateTime  @default(now())
  type      AlertType
  message   String
  resolved  Boolean   @default(false)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, resolved])
}
