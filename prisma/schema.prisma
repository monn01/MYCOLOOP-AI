// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
}

enum BatchStatus {
  RUNNING
  READY
  COMPLETED
  ABORTED
}

enum ReadinessStatus {
  BELUM_SIAP
  DALAM_PROSES
  SIAP_STERILISASI
}

enum AlertType {
  ANOMALY
  READY
}

/// Tiga stage pipeline fisik MYCOLOOP-AI (lihat PRD.md §1.1). Software ini
/// (Phase 0-8 di TASKPLAN.md) hanya pernah membuat/membaca batch berstage
/// PRE_CONDITIONING — MIXING dan INCUBATION disiapkan di sini supaya skema
/// tidak perlu migrasi besar saat software untuk stage itu mulai dikerjakan.
enum PipelineStage {
  MIXING
  PRE_CONDITIONING
  INCUBATION
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches Batch[]
}

model Batch {
  id        String        @id @default(cuid())
  startTime DateTime      @default(now())
  endTime   DateTime?
  status    BatchStatus   @default(RUNNING)
  stage     PipelineStage @default(PRE_CONDITIONING)
  formula   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  sensorReadings SensorReading[]
  aiDecisions    AIDecision[]
  alerts         Alert[]

  @@index([status])
  @@index([stage])
}

model SensorReading {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  suhu       Float
  kelembapan Float
  ph         Float

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, timestamp])
}

model AIDecision {
  id         String          @id @default(cuid())
  timestamp  DateTime        @default(now())
  status     ReadinessStatus
  confidence Float
  reasoning  String

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, timestamp])
}

model Alert {
  id        String    @id @default(cuid())
  timestamp DateTime  @default(now())
  type      AlertType
  message   String
  resolved  Boolean   @default(false)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, resolved])
}
