# PostgreSQL connection string (Neon/Supabase untuk dev, lihat PRD.md §11)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/mycoloop?schema=public"

# NextAuth
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

