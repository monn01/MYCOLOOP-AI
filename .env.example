# PostgreSQL connection string (Neon/Supabase untuk dev, lihat PRD.md §11)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/mycoloop?schema=public"

# NextAuth
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# MQTT broker (lihat TASKPLAN.md Phase 6a, lib/mqtt/bridge.ts buat kontrak topic)
# Dev lokal: docker run -d --name mycoloop-mosquitto -p 1883:1883 -v "$(pwd)/docker/mosquitto/mosquitto.conf:/mosquitto/config/mosquitto.conf" eclipse-mosquitto:2
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# AI Assistant (Gemini) - lihat PRD.md §7.8. Ambil key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opsional, default ke model flash terbaru kalau dikosongkan
GEMINI_MODEL="gemini-flash-latest"
